# Результаты Gradle генерируются заново и не должны попадать в репозиторий.
.gradle/
build/

# Локальные настройки IDE принадлежат конкретному рабочему месту.
.idea/
*.iml

# Системный файл macOS не относится к исходному коду.
.DS_Store

# Локальные параметры подключения могут содержать пароль.
.env
